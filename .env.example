# Copy this file to .env and fill in your own API keys.
# Never commit your actual .env file.

OPENAI_API_KEY=your-openai-api-key-here
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Used by ingestion/build_index.py for Gemini embeddings (gemini-embedding-001)
# and by app/generation.py for chat (gemini-3.5-flash-lite).
# google-genai's Client() reads either var; if both are set, GOOGLE_API_KEY wins.
GOOGLE_API_KEY=your-google-api-key-here
GEMINI_API_KEY=your-gemini-api-key-here

# MongoDB Atlas connection string. Used by ingestion/build_index.py to upsert
# chunks + create the Atlas Vector Search index, and by app/retrieval.py to
# query it. Requires an Atlas cluster tier that supports Vector Search.
MONGODB_URI=your-mongodb-atlas-connection-string-here
